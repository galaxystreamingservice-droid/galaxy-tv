<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="48dp"
    android:background="#03050C">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#EAFFFF" />

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="#7FD8E8" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="#9FC3D4" />

        <TextView
            android:id="@+id/expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button android:id="@+id/btnCheck"   android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Check for updates" />
        <Button android:id="@+id/btnInstall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Install updates" />
        <Button android:id="@+id/btnSelf"    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Update Galaxy TV Setup" />
        <Button android:id="@+id/btnDiag"    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Send diagnostics" />
        <Button android:id="@+id/btnUrl"     android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Set settings file URL" />
        <Button android:id="@+id/btnWifi"    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Change Wi-Fi / network" />
        <Button android:id="@+id/btnSystem"  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Open system settings (reset lives here)" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:background="#0B1420">
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#BFEAFF"
            android:text="Ready." />
    </ScrollView>
</LinearLayout>
