{
  "schemaVersion": 1,
  "deviceName": "Living Room Firestick",
  "owner": "galaxystreamingservice-droid",

  "sync": {
    "checkIntervalHours": 24,
    "maintenance": { "enabled": true, "dayOfWeek": "SUNDAY", "hour": 3 }
  },

  "debloat": {
    "disableAlexa": false,
    "blockOtaUpdates": false
  },

  "launcher": {
    "package": "com.spocky.projengmenu",
    "apkUrl": "https://github.com/galaxystreamingservice-droid/galaxy-tv/releases/download/assets/projectivy.apk",
    "shelfPosition": "bottom"
  },

  "performance": {
    "killPreviousApp": "auto"
  },

  "background": {
    "source": "gallery",
    "galleryImage": "ring-cyan",
    "effect": "beam"
